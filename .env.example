# Sticky Residential Proxy Configuration (DataImpulse or compatible gateway)
PROXY_HOST=gw.dataimpulse.com
PROXY_USER=your_proxy_user
PROXY_PASS=your_proxy_pass
PROXY_START_PORT=10000
PROXY_END_PORT=10998

# Input & State File Paths (stored in gitignored ./data directory)
ACCOUNTS_CSV=./data/emails_sheet.csv
LINKS_FILE=./data/activation_links.txt
PROXIES_META_FILE=./data/clean_proxies_metadata.json
LEDGER_FILE=./data/activation_ledger.json

# Runtime Output Directories
PROFILES_DIR=./avatarity_profiles
PROOFS_DIR=./proofs
BUNDLE_DIR=./avatarity_bundle
